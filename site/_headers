# Cloudflare Pages headers.
#
# Assets are requested with a ?v=<content hash> that scripts/build.ts rewrites
# into index.html on every build, so they can be cached hard and for ever: a
# changed file gets a new URL. The page itself and the data must revalidate,
# otherwise a stale index.html keeps pointing at the old asset URLs and nobody
# sees a deploy for four hours. That is exactly what happened on 2026-09-10.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The share card is the exception, and deliberately so. It is fetched by X,
# Slack, iMessage and friends, and a crawler is the one client that must never
# be handed a query string on an image URL - several of them drop or mangle it.
# So og.png carries no ?v= stamp, which means it cannot rely on a new URL to
# escape the year-long rule above. An hour is the trade: unfurlers re-fetch a
# redrawn card soon enough, and browsers barely request this file at all.
/assets/img/og.png
  Cache-Control: public, max-age=3600, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/data.json
  Cache-Control: public, max-age=60, must-revalidate
